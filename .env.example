# Salin file ini menjadi .env, lalu isi key asli.
# .env TIDAK BOLEH di-commit (sudah ada di .gitignore).
# Untuk versi online, isi variabel yang sama di Vercel → Settings → Environment Variables.

# API key dari https://platform.deepseek.com → API keys
DEEPSEEK_API_KEY=

# Opsional (bawaan: deepseek-chat)
DEEPSEEK_MODEL=deepseek-chat

# Opsional, port server lokal (bawaan: 8000)
PORT=8000
